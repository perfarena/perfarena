# Two ways to authenticate. Pick ONE.
#
# OPTION A (recommended, hardest to mess up):
# In DevTools -> Network, find any leetcode.com request after you log in,
# copy the entire `Cookie:` request header value, and paste it here.
# LEETCODE_COOKIE_HEADER=LEETCODE_SESSION=eyJ...; csrftoken=...; ...
LEETCODE_COOKIE_HEADER=
#
# OPTION B (individual cookies from Application -> Cookies -> https://leetcode.com):
# - LEETCODE_SESSION must be the long JWT (~600-900 chars, has two dots).
# - LEETCODE_CSRF_TOKEN must be the value of the `csrftoken` cookie (~32-64 chars).
LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=

# Optional: leetcode.com (default) or leetcode.cn
LEETCODE_HOST=https://leetcode.com
