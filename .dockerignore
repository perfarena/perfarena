# Anything not needed inside the image — keeps build context small and
# avoids leaking local dev artefacts.

# VCS
.git
.gitignore
.git*

# Local env / secrets
.env
.env.*
*.secrets
data/leetcode_accounts.json
data/human_solutions/

# Python caches
__pycache__
*.pyc
*.pyo
*.pyd
.venv
venv/
*.egg-info

# Node — built fresh inside the Node stage
frontend/node_modules
frontend/dist

# Backend local artefacts
backend/arena.db
backend/arena.db-journal
backend/.pytest_cache
backend/.venv
# Backend settings with LeetCode credentials; the container gets its settings from -e
backend/.env

# Editor / OS
.vscode
.idea
.DS_Store
*.swp

# Huge static parquet that isn't needed at runtime
data/train-00000-of-00001.parquet

# Build artifact directories that come from local runs
docs/
README.md
